// editorial-art: the ET Article art service.
//
// Conventions (IMPLEMENTATION_PLAN.md, Step 3):
// - Timestamps are timestamptz. Money is Decimal(12,4) rupees.
// - No image bytes are stored: only Cloudinary URLs and public ids.
// - Migrations are hand-written and checked with `prisma migrate diff --from-schema-datamodel`.
//   A real database is never used as a shadow database.
// - State changes are conditional updates on the current state (see src/pipeline/state.ts).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum RequestStatus {
  RECEIVED
  READING
  /// Paused after the read: the editor confirms the real people found in the story (pipeline/people.ts).
  NEEDS_PEOPLE_CONFIRM
  DIRECTIONS_READY
  ACTIVE
  HAS_FINAL
  FAILED
  CANCELLED
  EXPIRED
}

enum Sensitivity {
  NONE
  ELEVATED
  HIGH
  BLOCKED
}

enum BatchKind {
  INITIAL
  MORE
  ANOTHER_STYLE
  SERIES_MATCH
}

enum BatchStatus {
  QUEUED
  RUNNING
  READY
  PARTIAL
  FAILED
  CANCELLED
}

enum OptionState {
  PENDING
  GENERATING
  PREVIEW_READY
  PREVIEW_FAILED
  BLOCKED
  FINALIZING
  FINAL_READY
  FINAL_FAILED
  PACKING
  PACK_READY
  PACK_FAILED
}

enum PackStatus {
  PENDING
  READY
  FAILED
}

enum StyleStatus {
  DRAFT
  CURATING
  LIVE
  RETIRED
}

enum RefSource {
  GENERATED
  ET_ARCHIVE
  LICENSED
  ARTIST
}

enum RefStatus {
  CANDIDATE
  APPROVED
  REJECTED
  RETIRED
}

enum LikenessStatus {
  /// Found automatically (Wikimedia Commons) and not yet confirmed by an editor. Never sent to a model.
  CANDIDATE
  ACTIVE
  RETIRED
}

/// Where a likeness photo came from.
enum LikenessSource {
  /// Uploaded by an admin with a consent note (POST /admin/likenesses).
  ADMIN
  /// The Wikidata image (P18) of a public figure, from Wikimedia Commons, credited in the pack.
  WIKIMEDIA
  /// A photo an editor uploaded while confirming the people in a story.
  UPLOAD
}

/// What the editor chose for one real person in one request.
enum PersonDecision {
  PENDING
  /// Use the likeness shown; it becomes ACTIVE for everyone.
  USE
  /// Use a photo the editor uploaded; a new ACTIVE likeness.
  UPLOAD
  /// No likeness for this request: the person is shown symbolically.
  SYMBOLIC
}

enum AttemptResult {
  OK
  REFUSED
  ERROR
  TIMEOUT
}

/// One pasted article and everything made from it.
model Request {
  id                String        @id @default(uuid())
  /// `ear_` plus 22 base62 characters; the id AI Studio and the logs use.
  publicId          String        @unique
  /// Fingerprint of the internal API key that created it, never the key.
  callerKeyId       String
  actorUserId       String
  actorWorkspaceId  String
  /// The x-actor-role of the creator, for the real-people gate (EA_REAL_PEOPLE).
  actorRole         String        @default("member")
  clientRef         String?
  status            RequestStatus @default(RECEIVED)
  failureCode       String?
  failureReason     String?
  articleTitle      String?
  /// Null after retention (EA_ARTICLE_RETENTION_DAYS).
  articleText       String?
  articleHash       String
  articleChars      Int
  articleLang       String        @default("en")
  articleExcerpt    String
  /// Null after retention.
  prompt            String?
  styleId           String?
  /// An approved reference of `styleId` the editor chose; every option of the first batch uses it.
  pinnedReferenceId String?
  /// Approved references of `styleId` the editor chose, in order; every option of the first batch is made from exactly these.
  referenceIds      String[]      @default([])
  seriesOfRequestId String?
  sensitivity       Sensitivity?
  costInr           Decimal       @default(0) @db.Decimal(12, 4)
  spendCapInr       Decimal       @db.Decimal(12, 4)
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)
  expiresAt         DateTime      @db.Timestamptz(3)

  briefs  Brief[]
  batches Batch[]
  options Option[]
  people  RequestPerson[]

  @@unique([callerKeyId, clientRef])
  @@index([actorWorkspaceId, createdAt(sort: Desc)])
  @@index([actorUserId, status])
  @@index([status, updatedAt])
  @@index([articleHash])
}

/// What the read step understood. A re-read makes a new version; the latest is used.
model Brief {
  id                 String      @id @default(uuid())
  requestId          String
  request            Request     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  version            Int
  headline           String
  thesis             String
  entities           Json
  tone               String
  desk               String
  sensitivity        Sensitivity
  sensitivityReasons String[]
  altTextSeed        String
  /// ReadHook (shared-types model-outputs.ts): the news the images must tell. Null for briefs read before it existed.
  hook               Json?
  /// ReadIdentity (shared-types model-outputs.ts): the main subject first, then up to two other key actors, each with safe visual cues. [] for a broad-topic story; null for briefs read before it existed.
  identity           Json?
  /// The main subject's official logo (BrandLogo), found after the read when a direction asked for one and every gate allowed it.
  brandLogoId        String?
  truncatedForRead   Boolean     @default(false)
  model              String
  createdAt          DateTime    @default(now()) @db.Timestamptz(3)

  directions Direction[]

  @@unique([requestId, version])
}

/// One of the three ways to show the story.
model Direction {
  id                  String   @id @default(uuid())
  briefId             String
  brief               Brief    @relation(fields: [briefId], references: [id], onDelete: Cascade)
  rank                Int
  title               String
  idea                String
  suggestedStyleId    String
  reason              String
  /// [{ name, how: illustrated | symbolised | absent, likenessId? }]
  peopleDepicted      Json
  avoid               String[]
  /// 2 to 4 concrete things the image must show, tied to this story.
  mustShow            String[] @default([])
  /// One line linking the image to the story's claim.
  whyItFits           String   @default("")
  /// Which of the main subject's identity cues the idea shows.
  identityCues        String[] @default([])
  /// The idea asked for the main subject's official logo on its hero object (the read model decides, gates still apply).
  useLogo             Boolean  @default(false)
  /// The reader test, 1 to 10: does a reader of the headline connect this idea to the story? Null when the test did not run.
  readerScore         Int?
  /// The reader test, 1 to 10: would a reader name the main subject from the idea alone? Null when the story has no single subject.
  readerIdentityScore Int?
  readerReason        String?

  @@unique([briefId, rank])
}

/// Four options made together.
model Batch {
  id            String      @id @default(uuid())
  requestId     String
  request       Request     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  seq           Int
  kind          BatchKind
  styleId       String?
  /// BatchPlan (packages/shared-types/src/schemas/batch-plan.ts).
  directionPlan Json
  status        BatchStatus @default(QUEUED)
  requestedBy   String
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  completedAt   DateTime?   @db.Timestamptz(3)

  options Option[]

  @@unique([requestId, seq])
  @@index([status, createdAt])
}

/// One image, from preview to publish pack.
model Option {
  id              String      @id @default(uuid())
  batchId         String
  batch           Batch       @relation(fields: [batchId], references: [id], onDelete: Cascade)
  requestId       String
  request         Request     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  index           Int
  directionId     String
  styleId         String
  referenceIds    String[]
  likenessIds     String[]
  state           OptionState @default(PENDING)
  previewAttempts Int         @default(0)
  previewUrl      String?
  previewPublicId String?
  previewModel    String?
  /// Difference hash of the preview, to catch two near-identical options in one batch.
  previewHash     String?
  finalAttempts   Int         @default(0)
  finalUrl        String?
  finalPublicId   String?
  finalModel      String?
  judge           Json?
  /// What the last preview call sent, exactly: SentImageCall { model, prompt, images: [{ role, url }] } (shared-types api.ts). Admin only.
  previewInput    Json?
  /// What the last final call sent, in the same shape. Admin only.
  finalInput      Json?
  /// Cached subject boxes for smart cropping, as ratios.
  subjectBoxes    Json?
  /// The story check of the preview, 1 to 10: does it tell this article's story at a glance? Null when the check did not run or failed.
  storyScore      Int?
  storyReason     String?
  /// Same check, 1 to 10: without the headline, would a reader identify the company or person this is about? Null when the story has no single subject or the check failed.
  identityScore   Int?
  identityReason  String?
  /// The official logo (BrandLogo) this option was given, if any: at most one, the main subject's.
  brandLogoId     String?
  /// The logo came out present, legible and faithful. Null when the option has no logo or the check did not say.
  logoOk          Boolean?
  /// Story redraws so far. A batch redraws at most one option, once.
  storyRedraws    Int         @default(0)
  blockedReason   String?
  failureReason   String?
  /// The drawn face still looked unlike the reference photos after one redraw.
  likenessWeak    Boolean     @default(false)
  picked          Boolean     @default(false)
  pickedAt        DateTime?   @db.Timestamptz(3)
  createdAt       DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @db.Timestamptz(3)

  pack PublishPack?

  @@unique([batchId, index])
  @@index([requestId, state])
  @@index([state, updatedAt])
}

/// A company's or brand's official logo, placed exactly as given on an image's hero object.
/// Found on Wikidata (P154) and Wikimedia Commons, freely licensed only; an admin may later
/// retire one or upload a replacement.
model BrandLogo {
  id          String          @id @default(uuid())
  name        String
  /// Names the read used for this brand, matched case- and accent-insensitively.
  aliases     String[]        @default([])
  /// The Wikidata item (Q-id) the logo was found on.
  wikidataId  String?
  /// Our stored PNG copy.
  url         String
  publicId    String?
  width       Int?
  height      Int?
  /// LicenseShortName from Commons, for example "Public domain".
  licence     String?
  licenceUrl  String?
  /// The author as Commons names them (Artist), as plain text.
  credit      String?
  /// The Commons file page the logo came from.
  commonsPage String?
  source      BrandLogoSource
  status      BrandLogoStatus @default(ACTIVE)
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)

  @@index([wikidataId])
  @@index([status])
}

enum BrandLogoSource {
  /// The Wikidata logo image (P154), from Wikimedia Commons, credited in the pack.
  WIKIMEDIA
  /// Uploaded by an admin.
  UPLOAD
}

enum BrandLogoStatus {
  ACTIVE
  /// Taken down by an admin: never used, and never looked up again for the same brand.
  RETIRED
}

/// The sizes, alt text, caption and credit for a finalized option.
model PublishPack {
  id        String     @id @default(uuid())
  optionId  String     @unique
  option    Option     @relation(fields: [optionId], references: [id], onDelete: Cascade)
  /// PackAsset[] (packages/shared-types/src/schemas/api.ts).
  assets    Json
  altText   String
  caption   String
  credit    String
  status    PackStatus @default(PENDING)
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @db.Timestamptz(3)
}

model StyleFamily {
  id        String  @id @default(uuid())
  slug      String  @unique
  label     String
  sortOrder Int
  styles    Style[]
}

/// One of the ET house styles (docs/STYLE_LIBRARY.md). Styles that leave the library are retired, never deleted.
model Style {
  id                String      @id @default(uuid())
  familyId          String
  family            StyleFamily @relation(fields: [familyId], references: [id])
  slug              String      @unique
  label             String
  summary           String
  ruleSheet         Json
  goodFor           String[]
  safety            Json
  status            StyleStatus @default(DRAFT)
  minApprovedRefs   Int         @default(15)
  sortOrder         Int
  coverReferenceIds String[]
  createdAt         DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime    @updatedAt @db.Timestamptz(3)
  retiredAt         DateTime?   @db.Timestamptz(3)

  references StyleReference[]

  @@index([status, sortOrder])
}

/// An image the model sees to learn a style. Only approved references are ever sent.
model StyleReference {
  id             String                       @id @default(uuid())
  styleId        String
  style          Style                        @relation(fields: [styleId], references: [id])
  source         RefSource
  sourceNote     String
  /// The neutral subject an exemplar was made from, so a re-run can skip it.
  subjectHint    String?
  url            String
  publicId       String
  width          Int
  height         Int
  description    String
  subjects       String[]
  mood           String
  embedding      Unsupported("vector(1536)")?
  embeddingModel String?
  /// The artist of an ARTIST reference; null for generated, archive and licensed images.
  artistId       String?
  artist         Artist?                      @relation(fields: [artistId], references: [id])
  /// The public page the artwork was found on.
  sourceUrl      String?
  /// { passed, reason } from the automatic screen.
  screen         Json?
  status         RefStatus                    @default(CANDIDATE)
  reviewedBy     String?
  reviewedAt     DateTime?                    @db.Timestamptz(3)
  reviewNote     String?
  usageCount     Int                          @default(0)
  pickCount      Int                          @default(0)
  createdAt      DateTime                     @default(now()) @db.Timestamptz(3)

  @@index([styleId, status])
  @@index([styleId, artistId, status])
}

/// A working artist whose published portfolio images teach a style. Never named in prompts.
model Artist {
  id           String   @id @default(uuid())
  slug         String   @unique
  name         String
  portfolioUrl String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  references StyleReference[]
}

/// Approved photos of a real person, for illustrated depiction only.
model Likeness {
  id          String         @id @default(uuid())
  name        String
  aliases     String[]
  /// [{ url, publicId, width, height }]
  photos      Json
  consentNote String
  approvedBy  String
  status      LikenessStatus @default(ACTIVE)
  source      LikenessSource @default(ADMIN)
  /// The Wikidata item (Q-id) of a WIKIMEDIA likeness.
  wikidataId  String?
  /// Wikidata's short description, for example "Indian businessman".
  description String?
  /// The Commons file page the photo came from.
  commonsPage String?
  /// LicenseShortName from Commons, for example "CC BY-SA 4.0".
  licence     String?
  licenceUrl  String?
  /// The photographer or author as Commons names them (Artist), as plain text.
  credit      String?
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(3)

  requestPeople RequestPerson[]

  @@index([wikidataId])
  @@index([status])
}

/// A real person the read found in one request, while the editor confirms how to show them.
model RequestPerson {
  id         String         @id @default(uuid())
  requestId  String
  request    Request        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  /// The name as the story gives it.
  name       String
  /// Other names in the story that matched the same person.
  otherNames String[]       @default([])
  /// The role the read gave, for example "chairman, Tata Sons".
  role       String         @default("")
  /// The likeness on offer (CANDIDATE or ACTIVE), or the one chosen.
  likenessId String?
  likeness   Likeness?      @relation(fields: [likenessId], references: [id])
  /// Ranked Wikidata candidates not shown yet, for "Try another": [{ wikidataId, label, description, imageFile, score }].
  candidates Json           @default("[]")
  /// Wikidata ids already shown in this request.
  tried      String[]       @default([])
  decision   PersonDecision @default(PENDING)
  decidedBy  String?
  decidedAt  DateTime?      @db.Timestamptz(3)
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)

  @@unique([requestId, name])
  @@index([likenessId])
}

/// One paid model call, success or not.
model Attempt {
  id           String        @id @default(uuid())
  requestId    String?
  optionId     String?
  stage        String
  provider     String
  model        String
  result       AttemptResult
  errorCode    String?
  inputTokens  Int           @default(0)
  outputTokens Int           @default(0)
  imageTokens  Int           @default(0)
  costInr      Decimal       @db.Decimal(12, 4)
  latencyMs    Int
  startedAt    DateTime      @db.Timestamptz(3)
  completedAt  DateTime      @db.Timestamptz(3)

  @@index([startedAt])
  @@index([requestId])
  @@index([stage, result])
}

/// Spend per UTC day. The row for 1970-01-01 holds the build-period total.
model SpendLedger {
  day       DateTime @id @db.Date
  costInr   Decimal  @default(0) @db.Decimal(12, 4)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

/// Settings admins change at run time, one JSON value per key (for example "image-models").
model Setting {
  key       String   @id
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model AuditEvent {
  id          String   @id @default(uuid())
  at          DateTime @default(now()) @db.Timestamptz(3)
  actorUserId String?
  callerKeyId String?
  action      String
  targetType  String
  targetId    String
  metadata    Json

  @@index([at])
  @@index([targetType, targetId])
}
