# Cloudinary orphan sweep
# Started by editorial-art-sweep.timer; runs once and exits.

[Unit]
Description=editorial-art: Cloudinary orphan sweep
After=network.target postgresql.service redis-server.service

[Service]
Type=oneshot
User=abhigyan.raj
Group=et-product-dev
WorkingDirectory=/data/products/editorial-art/apps/api
EnvironmentFile=/data/products/editorial-art/.env
Environment=NODE_ENV=production
ExecStart=/data/abhigyan.raj/.bun/bin/bun run src/scripts/sweep-cloudinary.ts --apply
UMask=0002
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/data/products/editorial-art/logs
StandardOutput=append:/data/products/editorial-art/logs/editorial-art-sweep.log
StandardError=append:/data/products/editorial-art/logs/editorial-art-sweep.log
