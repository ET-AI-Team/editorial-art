# editorial-art configuration. Every variable is described in docs/IMPLEMENTATION_PLAN.md,
# Appendix C. Secrets are marked; never commit a filled-in copy.

NODE_ENV=production
LOG_LEVEL=info

# Network: loopback only. AI Studio's API calls this on the same box.
EA_HOST=127.0.0.1
EA_PORT=7701
EA_ROLE=all
EA_WORKER_HEALTH_PORT=7702

# Storage
DATABASE_URL=postgresql://editorial_art:CHANGE_ME@127.0.0.1:5432/editorial_art   # secret
REDIS_URL=redis://127.0.0.1:6379
EA_QUEUE_PREFIX=ea

# Internal API keys (comma-separated so one can be rotated). Generate: openssl rand -hex 32
EA_INTERNAL_API_KEYS=CHANGE_ME   # secret
EA_API_KEY_REQUIRED=true

# Providers
EA_FAKE_PROVIDERS=false
OPENAI_API_KEY=   # secret
GEMINI_API_KEY=   # secret
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=   # secret
CLOUDINARY_API_SECRET=   # secret
EA_CLOUDINARY_FOLDER=editorial-art

# Models (no defaults in code on purpose)
EA_READ_MODEL=gpt-4.1
EA_TEXT_MODEL=gpt-4.1
EA_JUDGE_MODEL=gpt-4.1
EA_EMBED_MODEL=text-embedding-3-small
EA_PREVIEW_MODEL=gemini-3.1-flash-image
EA_PREVIEW_FALLBACK_MODEL=gemini-3-pro-image
EA_FINAL_MODEL=gemini-3-pro-image
EA_FINAL_FALLBACK_MODEL=gpt-image-2

# Concurrency
EA_READ_CONCURRENCY=6
EA_PREVIEW_CONCURRENCY=8
EA_FINALIZE_CONCURRENCY=4
EA_PACK_CONCURRENCY=4
EA_LIBRARY_CONCURRENCY=4

# Spend caps (rupees). The build cap is removed at launch.
EA_REQUEST_SPEND_CAP_INR=200
EA_DAILY_SPEND_CAP_INR=3000
EA_BUILD_SPEND_CAP_INR=8000

# Rate limits (per hour)
EA_RATE_CREATE_PER_HOUR=30
EA_RATE_BATCH_PER_HOUR=60
EA_RATE_FINALIZE_PER_HOUR=40
EA_RATE_WORKSPACE_WRITES_PER_HOUR=200
EA_RATE_LIBRARY_PER_HOUR=10
EA_USER_CONCURRENT_REQUESTS=3

# Limits and retention
EA_MAX_BATCHES_PER_REQUEST=8
EA_ARTICLE_RETENTION_DAYS=90
EA_PREVIEW_RETENTION_DAYS=180
EA_CREDIT_LINE="AI illustration: ET"

# Optional: where the style library lives (defaults to docs/STYLE_LIBRARY.md in this repo)
# EA_STYLE_LIBRARY_PATH=
